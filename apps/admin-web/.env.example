# admin-web environment
#
# WARNING: Vite inlines every VITE_-prefixed variable into the JavaScript bundle at build
# time. Everything here is PUBLIC and readable by anyone who loads the page. Never put an
# API secret, service account, or database URL in this file.

# Base URL of the Driver Complaint API. No trailing slash, no /api/v1 suffix.
# The app appends /api/v1 itself, and connects Socket.IO to this same origin.
VITE_API_URL=http://localhost:4000
