# Expo caches and export output
.expo/

# Generated by `expo prebuild`. Regenerated from app.json / app.config.ts, so committing it
# would mean maintaining two sources of truth for the native projects.
/android/
/ios/

# Firebase project files. Not credentials in the signing sense (they ship inside the app),
# but project-specific — they come from the user's Firebase console, per environment.
google-services.json
GoogleService-Info.plist

# Signing material. Must never reach the repo.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
