{
  "name": "@driver-complaint/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npx expo@54 start --go",
    "start:go": "npx expo@54 start --go",
    "start:dev-client": "npx expo@54 start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "bundle": "expo export --platform android --output-dir dist",
    "doctor": "npx --yes expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@driver-complaint/shared-types": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-firebase/app": "^21.6.0",
    "@react-native-firebase/messaging": "^21.6.0",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.7",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^2.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
