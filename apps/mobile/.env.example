# API the app talks to. EXPO_PUBLIC_ variables are INLINED INTO THE APP BUNDLE at build
# time and are readable by anyone who unzips the APK — never put a secret here.
#
# Physical device on the same Wi-Fi: use the machine's LAN IP, not localhost. `localhost` on
# a phone means the phone itself. Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Paths to the Firebase credential files, if you have a Firebase project yet. Leave both
# unset and the app builds and runs with push disabled (see app.config.ts).
# Put the files in this folder — they are gitignored.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
