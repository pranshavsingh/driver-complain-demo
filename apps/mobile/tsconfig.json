{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "app",
    "src",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "android",
    "ios"
  ]
}
