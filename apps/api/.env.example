NODE_ENV=development
PORT=4000

# PostgreSQL — supply your existing hosted or local database connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# DIRECT_URL=                         # only if using a connection pooler (Neon/pgbouncer)

# Auth — use long random strings in staging/production (32+ chars).
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-16-chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-different
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
JWT_ISSUER=driver-complaint
JWT_AUDIENCE=driver-complaint-api

# Sentry — leave DSN empty in local dev to disable capture.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Cloudinary — attachments. Folder is per-environment: driver-complaint/{local,staging,prod}
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=driver-complaint/local

# Speech-to-text — downloaded from Hugging Face and run locally; no API key is required.
# This is the highest-accuracy multilingual Faster-Whisper model, but needs significant RAM.
TRANSCRIPTION_LOCAL_MODEL=large-v3

# Firebase Cloud Messaging (push). Leave BOTH empty to disable push — the API then
# logs "push disabled" instead of sending, and everything else works normally.
# FIREBASE_SERVICE_ACCOUNT takes the service-account JSON as a single line, either as
# raw JSON or base64-encoded (base64 avoids escaping the private_key newlines).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# HTTP
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Login throttling (low-entropy PINs)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
