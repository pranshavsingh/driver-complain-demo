// Driver Complaint — data model v1.
// Enum VALUES mirror packages/shared-types/src/enums.ts by hand (intentional, low-churn).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  EXECUTIVE
  ADMIN
  SUPER_ADMIN
}

enum ApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

enum ComplaintCategory {
  LOADING
  UNLOADING
  BREAKDOWN
  TYRE_ISSUE
  FUEL_DEF
  ACCOUNTS
  VEHICLE_MAINTENANCE
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  COMPLAINT_CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENT_ADDED
  ASSIGNMENT_REQUESTED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_REJECTED
  VEHICLE_ASSIGNED
  VEHICLE_UNASSIGNED
  SPARE_PART_REQUESTED
  SPARE_PART_ISSUE_PROPOSED
  SPARE_PART_APPROVED
  SPARE_PART_ISSUED
  SPARE_PART_REJECTED
  SUPPORT_MESSAGE_RECEIVED
  USER_APPROVAL_REQUESTED
  USER_APPROVED
  USER_REJECTED
  SLA_BREACH_ESCALATION
}

// What kind of evidence an attachment is. Drives playback in the dashboard (an <img> and an
// <audio> are not interchangeable) and the per-kind size limits on upload. Cloudinary's own
// resourceType cannot carry this: it stores audio under resource_type "video".
enum AttachmentKind {
  PHOTO
  VOICE
  VIDEO
}

enum RevokedReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  EXPIRED
  ADMIN_REVOKED
}

enum Platform {
  ANDROID
  IOS
  WEB
}

model User {
  id                  String            @id @default(uuid(7)) @db.VarChar(36)
  employeeId          String            @unique
  pinHash             String
  role                Role              @default(DRIVER)
  approvalStatus      ApprovalStatus    @default(APPROVED)
  category            ComplaintCategory?
  site                String?
  createdByAdminId    String?           @db.VarChar(36)
  firstName           String
  lastName            String
  email               String?           @unique
  phone               String?
  isActive            Boolean           @default(true)
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  driver                  Driver?
  assignedComplaints      Complaint[]           @relation("AssignedAdmin")
  pendingComplaints       Complaint[]           @relation("PendingAssignee")
  complaintUpdates        ComplaintUpdate[]
  uploadedAttachments     ComplaintAttachment[]
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  refreshTokens           RefreshToken[]
  proposedSpareParts      SparePartRequest[]    @relation("SparePartProposedBy")
  approvedSpareParts      SparePartRequest[]    @relation("SparePartApprovedBy")
  issuedSpareParts        SparePartRequest[]    @relation("SparePartIssuedBy")
  sentSupportMessages     SupportMessage[]      @relation("SentSupportMessages")
  receivedSupportMessages SupportMessage[]      @relation("ReceivedSupportMessages")
  siteInchargeVehicles    Vehicle[]             @relation("SiteInchargeVehicles")
  adminCategoryAssignments AdminCategoryAssignment[] @relation("AdminCategories")

  @@index([role])
  @@index([approvalStatus])
  @@index([createdByAdminId])
  @@index([createdAt, id])
}

model Driver {
  id            String    @id @default(uuid(7)) @db.VarChar(36)
  userId        String    @unique @db.VarChar(36)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String    @unique
  licenseExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicles           Vehicle[]
  complaints         Complaint[]
  loadingRecords     LoadingRecord[]
  fuelRecords        FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  sparePartRequests  SparePartRequest[]
}

model Vehicle {
  id               String    @id @default(uuid(7)) @db.VarChar(36)
  driverId         String?   @db.VarChar(36)
  driver           Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  siteInchargeId   String?   @db.VarChar(36)
  siteIncharge     User?     @relation("SiteInchargeVehicles", fields: [siteInchargeId], references: [id], onDelete: SetNull)
  plateNumber      String    @unique
  make             String?
  model            String?
  modelNumber      String?
  registrationDate DateTime?
  chassisNumber    String?
  wheels           String?
  agreementStatus  String?   @default("ACTIVE")
  year             Int?
  vin              String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  complaints         Complaint[]
  fuelRecords        FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  sparePartRequests  SparePartRequest[]

  @@index([driverId])
  @@index([siteInchargeId])
  @@index([createdAt, id])
}

model Complaint {
  id                String            @id @default(uuid(7)) @db.VarChar(36)
  complaintNo       String            @unique
  driverId          String            @db.VarChar(36)
  driver            Driver            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId         String?           @db.VarChar(36)
  vehicle           Vehicle?          @relation(fields: [vehicleId], references: [id])
  title             String
  description       String @db.Text
  transcription     String? @db.Text
  category          ComplaintCategory @default(BREAKDOWN)
  status            ComplaintStatus   @default(NEW)
  priority          Priority          @default(MEDIUM)
  tripPhase         String?
  latitude          Float?
  longitude         Float?
  locationName      String?
  assignedToId      String?           @db.VarChar(36)
  assignedTo        User?             @relation("AssignedAdmin", fields: [assignedToId], references: [id])
  pendingAssigneeId String?           @db.VarChar(36)
  pendingAssignee   User?             @relation("PendingAssignee", fields: [pendingAssigneeId], references: [id])
  assignmentStatus  AssignmentStatus  @default(NONE)
  resolvedAt        DateTime?
  lastSlaEscalatedAt DateTime?
  idempotencyKey    String? @db.VarChar(255)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  attachments           ComplaintAttachment[]
  updates               ComplaintUpdate[]
  notifications         Notification[]
  loadingRecords        LoadingRecord[]
  linkedSupportMessages SupportMessage[]      @relation("LinkedMessages")

  @@unique([driverId, idempotencyKey])
  @@index([idempotencyKey])
  @@index([status])
  @@index([driverId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([driverId, status])
  @@index([vehicleId])
}

model ComplaintAttachment {
  id           String    @id @default(uuid(7)) @db.VarChar(36)
  complaintId  String    @db.VarChar(36)
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploadedById String?   @db.VarChar(36)
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  // Defaulted to PHOTO so the column could be added to existing rows (all of which were
  // photos) without a data migration. Every write path sets it explicitly — treat the default
  // as a backfill artefact, not a fallback to rely on.
  kind         AttachmentKind @default(PHOTO)
  url          String @db.Text
  publicId     String         @unique
  resourceType String
  format       String?
  bytes        Int?
  /// Runtime of a voice note or video, from Cloudinary. Null for photos.
  durationSec  Int?
  originalName String? @db.VarChar(255)
  transcription String? @db.Text
  createdAt    DateTime       @default(now())

  @@index([complaintId])
}

model ComplaintUpdate {
  id          String           @id @default(uuid(7)) @db.VarChar(36)
  complaintId String           @db.VarChar(36)
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String?          @db.VarChar(36)
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  note        String? @db.Text
  createdAt   DateTime         @default(now())

  @@index([complaintId])
}

model Notification {
  id          String           @id @default(uuid(7)) @db.VarChar(36)
  userId      String           @db.VarChar(36)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String @db.Text
  data        Json?
  complaintId String?          @db.VarChar(36)
  complaint   Complaint?       @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  clearedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, clearedAt])
}

model DeviceToken {
  id         String   @id @default(uuid(7)) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique @db.VarChar(255)
  platform   Platform
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ADDED beyond the 7 v1 entities — required for refresh-token rotation, reuse
// detection, and server-side revocation (JWTs alone can't be revoked).
model RefreshToken {
  id            String         @id @default(uuid(7)) @db.VarChar(36)
  userId        String         @db.VarChar(36)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId      String         @db.VarChar(36)
  tokenHash     String         @unique @db.VarChar(255)
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokedReason?
  replacedById  String?        @unique @db.VarChar(36)
  userAgent     String? @db.Text
  ipAddress     String?
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// Monotonic counters for human-readable identifiers (e.g. complaintNo). Keyed by
// name (e.g. "complaint-2026"); incremented atomically inside the create transaction.
// Kept in-schema (rather than a raw Postgres sequence) so migrate-diff drift checks stay clean.
model Counter {
  name  String @id
  value Int    @default(0)
}

/// One loading/trip cycle runs REACHED -> COMPLETED -> TRIP_STARTED -> UNLOADING -> TRIP_COMPLETED.
/// UNLOADING means the driver has arrived at the destination and unloading is under way;
/// TRIP_COMPLETED is the single terminal state and only fires once unloading is done.
enum LoadingStatus {
  REACHED
  COMPLETED
  TRIP_STARTED
  UNLOADING
  TRIP_COMPLETED
}

model LoadingRecord {
  id                     String        @id @default(uuid(7)) @db.VarChar(36)
  driverId               String        @db.VarChar(36)
  driver                 Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  complaintId            String?       @db.VarChar(36)
  complaint              Complaint?    @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  locationName           String? @db.VarChar(255)

  reachedAt              DateTime      @default(now())
  reachedLatitude        Float
  reachedLongitude       Float
  reachedAddress         String? @db.VarChar(500)
  reachedPhotoUrl        String @db.Text
  reachedPublicId        String?

  completedAt            DateTime?
  completedLatitude      Float?
  completedLongitude     Float?
  completedAddress       String? @db.VarChar(500)
  completedPhotoUrl      String? @db.Text
  completedPublicId      String?

  tripStartedAt          DateTime?
  tripStartLatitude      Float?
  tripStartLongitude     Float?
  tripStartAddress       String? @db.VarChar(500)

  // tripCompletedAt is the moment the driver reached the unloading point, so it is
  // both the end of transit (tripDurationMinutes) and the start of the unloading wait.
  tripCompletedAt        DateTime?
  tripCompletedLatitude  Float?
  tripCompletedLongitude Float?
  tripCompletedAddress   String? @db.VarChar(500)
  tripCompletedPhotoUrl  String? @db.Text
  tripCompletedPublicId  String?
  tripDurationMinutes    Int?

  // Unloading finished at the destination. unloadingDurationMinutes = unloadingCompletedAt - tripCompletedAt.
  unloadingCompletedAt     DateTime?
  unloadingLatitude        Float?
  unloadingLongitude       Float?
  unloadingAddress         String? @db.VarChar(500)
  unloadingPhotoUrl        String? @db.Text
  unloadingPublicId        String?
  unloadingDurationMinutes Int?

  /// Wait at the loading point: completedAt - reachedAt.
  waitingTimeMinutes     Int?
  status                 LoadingStatus @default(REACHED)

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([driverId])
  @@index([complaintId])
  @@index([status])
  @@index([reachedAt])
  @@index([driverId, status, createdAt])
}

enum FuelType {
  FUEL
  DEF
}

model FuelRecord {
  id              String   @id @default(uuid(7)) @db.VarChar(36)
  driverId        String   @db.VarChar(36)
  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId       String   @db.VarChar(36)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            FuelType @default(FUEL)
  quantityLtr     Float
  totalPrice      Float
  ratePerLtr      Float?
  odometerKm      Int?
  receiptUrl      String? @db.Text
  receiptPublicId String?
  notes           String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
}

enum MaintenanceType {
  TYRE
  BATTERY
}

model MaintenanceRecord {
  id              String          @id @default(uuid(7)) @db.VarChar(36)
  driverId        String          @db.VarChar(36)
  driver          Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId       String          @db.VarChar(36)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            MaintenanceType @default(TYRE)
  itemNumber      String
  oldItemNumber   String?
  quantity        Int             @default(1)
  photoUrl        String @db.Text
  photoPublicId   String?
  odometerKm      Int?
  brand           String?
  position        String?
  cost            Float?
  notes           String? @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
}

model Warehouse {
  id          String             @id @default(uuid(7)) @db.VarChar(36)
  name        String             @unique
  code        String?            @unique
  location    String?
  contactPerson String?
  contactPhone  String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  issuedParts SparePartRequest[]
}

enum SparePartRequestStatus {
  PENDING_APPROVAL
  ISSUE_PENDING_APPROVAL
  APPROVED
  ISSUED
  REJECTED
}

enum SparePartType {
  NEW
  EXCHANGE
  REPAIR
  OTHER
}

model SparePartRequest {
  id                    String                 @id @default(uuid(7)) @db.VarChar(36)
  requestNo             String                 @unique
  driverId              String                 @db.VarChar(36)
  driver                Driver                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId             String                 @db.VarChar(36)
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Driver Request Details
  description           String @db.Text
  transcription         String? @db.Text
  partName              String?
  quantity              Int                    @default(1)

  // Evidence
  photoUrl              String? @db.Text
  photoPublicId         String?
  voiceUrl              String? @db.Text
  voicePublicId         String?

  // Status & Type
  status                SparePartRequestStatus @default(PENDING_APPROVAL)
  type                  SparePartType          @default(NEW)
  category              ComplaintCategory?

  // Executive / Admin Issue Proposal
  issueProposedById     String?                @db.VarChar(36)
  issueProposedBy       User?                  @relation("SparePartProposedBy", fields: [issueProposedById], references: [id], onDelete: SetNull)
  issueProposedAt       DateTime?

  // SuperAdmin Approval
  approvedById          String?                @db.VarChar(36)
  approvedBy            User?                  @relation("SparePartApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?

  // Issuance & Warehouse
  issuedById            String?                @db.VarChar(36)
  issuedBy              User?                  @relation("SparePartIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt              DateTime?
  warehouseId           String?                @db.VarChar(36)
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Issued item details
  issuedPartName        String?
  issuedPartNo          String?
  issuedQty             Int?
  // Structured per-item list with per-item return tracking
  issuedItems           Json?

  // Exchange details (item received back from driver)
  returnedPartNo        String?
  returnedPartCondition String?

  adminNotes            String? @db.Text
  rejectionReason       String? @db.Text

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
}

enum SupportMessageType {
  TEXT
  IMAGE
  AUDIO
}

model SupportMessage {
  id                    String             @id @default(uuid(7)) @db.VarChar(36)
  senderId              String             @db.VarChar(36)
  sender                User               @relation("SentSupportMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId            String             @db.VarChar(36)
  receiver              User               @relation("ReceivedSupportMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content               String             @db.Text
  type                  SupportMessageType @default(TEXT)

  attachmentUrl         String? @db.Text
  attachmentPublicId    String?
  attachmentDurationSec Int?

  isRead                Boolean            @default(false)
  readAt                DateTime?

  linkedComplaintId     String?            @db.VarChar(36)
  linkedComplaint       Complaint?         @relation("LinkedMessages", fields: [linkedComplaintId], references: [id], onDelete: SetNull)
  linkedComplaintNo     String?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@index([senderId, isRead])
  @@index([createdAt])
}

model OperatingSite {
  id          String    @id @default(uuid(7)) @db.VarChar(36)
  name        String    @unique
  code        String?   @unique
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model CategorySla {
  id        String            @id @default(uuid(7)) @db.VarChar(36)
  category  ComplaintCategory @unique
  slaHours  Float             @default(12.0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model AdminCategoryAssignment {
  id        String            @id @default(uuid(7)) @db.VarChar(36)
  adminId   String            @db.VarChar(36)
  admin     User              @relation("AdminCategories", fields: [adminId], references: [id], onDelete: Cascade)
  category  ComplaintCategory
  createdAt DateTime          @default(now())

  @@unique([adminId, category])
  @@index([adminId])
  @@index([category])
}

// ──────────────────────────────────────────────────────────────
// Milestone 3: Durable Outbox & Reliable Fan-out Architecture
// ──────────────────────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
  DEAD_LETTER
  SUPERSEDED
  CANCELLED
}

enum ConsumerState {
  ACTIVE
  PAUSED
  DRAINING
  RETIRED
  BLOCKED
  COMPROMISED
}

enum DispatchIntentStatus {
  PLANNED
  ASSIGNED
  DELIVERED
  EXPIRED
  REVOKED
}

enum DeliveryOutcome {
  DELIVERED
  RETRIABLE_FAILURE
  TERMINAL_FAILURE
  LEASE_EXPIRED
  SUSPENDED_BY_RETIREMENT
  REVOKED
  UNCERTAIN
}

enum ResolutionStatus {
  IN_FLIGHT
  COMMITTED
  ROLLED_BACK
  UNCERTAIN_NEEDS_WATCHDOG
  DEAD_LETTERED
}

enum ArchivalReason {
  TTL_EXPIRED
  RETIREMENT_SWEEP
  REGULATORY_HOLD
  MANUAL_PURGE
  DLQ_DRAIN
}

model RegisteredConsumer {
  id                   String                         @id @default(uuid(7)) @db.VarChar(36)
  consumerGroup        String
  consumerName         String
  state                ConsumerState                  @default(ACTIVE)
  filterPattern        Json?
  maxInFlight          Int                            @default(10)
  leaseDurationSeconds Int                            @default(30)
  retiredAt            DateTime?
  metadata             Json?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  dispatchIntents      OutboxConsumerDispatchIntent[]
  deliveryLedgers      DeliveryLedger[]
  aggregateCursors     ConsumerAggregateCursor[]
  resolutionRecords    SequenceResolutionRecord[]

  @@unique([consumerGroup, consumerName])
  @@index([state])
  @@index([consumerGroup])
}

model TransactionalOutbox {
  id                    String                         @id @default(uuid(7)) @db.VarChar(36)
  aggregateType         String
  aggregateId           String
  eventType             String
  payload               Json
  headers               Json?
  status                OutboxStatus                   @default(PENDING)
  isFanoutSealed        Boolean                        @default(false)
  expectedConsumerCount Int                            @default(0)
  retryCount            Int                            @default(0)
  maxRetries            Int                            @default(5)
  scheduledAt           DateTime                       @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  dispatchIntents       OutboxConsumerDispatchIntent[]
  deliveryLedgers       DeliveryLedger[]
  resolutionRecords     SequenceResolutionRecord[]

  @@index([status, scheduledAt])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

model OutboxConsumerDispatchIntent {
  id             String               @id @default(uuid(7)) @db.VarChar(36)
  outboxId       String               @db.VarChar(36)
  outbox         TransactionalOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  consumerId     String               @db.VarChar(36)
  consumer       RegisteredConsumer   @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  sequenceNumber BigInt
  status         DispatchIntentStatus @default(PLANNED)
  deliveredAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  deliveryLedgers DeliveryLedger[]

  @@unique([outboxId, consumerId])
  @@unique([consumerId, sequenceNumber])
  @@index([consumerId, status])
  @@index([status])
}

model DeliveryLedger {
  id                  String                       @id @default(uuid(7)) @db.VarChar(36)
  intentId            String                       @db.VarChar(36)
  intent              OutboxConsumerDispatchIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  consumerId          String                       @db.VarChar(36)
  consumer            RegisteredConsumer           @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  outboxId            String                       @db.VarChar(36)
  outbox              TransactionalOutbox          @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  claimEpoch          BigInt                       @default(0)
  claimCount          Int                          @default(0)
  leaseToken          String?                      @db.VarChar(36)
  leaseExpiresAt      DateTime?
  lastWorkerId        String?
  outcome             DeliveryOutcome?
  outcomeReason       String? @db.Text
  executionDurationMs Int?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([consumerId, leaseExpiresAt])
  @@index([outboxId])
  @@index([intentId])
  @@index([outcome])
}

model ConsumerAggregateCursor {
  id                    String             @id @default(uuid(7)) @db.VarChar(36)
  consumerId            String             @db.VarChar(36)
  consumer              RegisteredConsumer @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  aggregateType         String
  aggregateId           String
  lastDeliveredSequence BigInt             @default(0)
  lastDeliveredOutboxId String?            @db.VarChar(36)
  updatedAt             DateTime           @updatedAt

  @@unique([consumerId, aggregateType, aggregateId])
  @@index([consumerId])
}

model SequenceResolutionRecord {
  id              String              @id @default(uuid(7)) @db.VarChar(36)
  consumerId      String              @db.VarChar(36)
  consumer        RegisteredConsumer  @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  aggregateType   String
  aggregateId     String
  sequenceNumber  BigInt
  outboxId        String              @db.VarChar(36)
  outbox          TransactionalOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  status          ResolutionStatus    @default(IN_FLIGHT)
  resolutionNotes String? @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([consumerId, sequenceNumber])
  @@index([consumerId, status])
  @@index([outboxId])
}

model TransactionalOutboxArchive {
  id                    String          @id @db.VarChar(36)
  aggregateType         String
  aggregateId           String
  eventType             String
  payload               Json
  headers               Json?
  status                OutboxStatus
  isFanoutSealed        Boolean
  expectedConsumerCount Int
  retryCount            Int
  maxRetries            Int
  scheduledAt           DateTime
  lockedAt              DateTime?
  lockedBy              String?
  publishedAt           DateTime?
  archivedAt            DateTime
  createdAt             DateTime
  updatedAt             DateTime
  archiveBatchId        String          @db.VarChar(36)
  archivedReason        ArchivalReason
  archivedTimestamp     DateTime        @default(now())

  @@index([archiveBatchId])
  @@index([archivedTimestamp])
  @@index([aggregateType, aggregateId])
}

model OutboxConsumerDispatchIntentArchive {
  id                String               @id @db.VarChar(36)
  outboxId          String               @db.VarChar(36)
  consumerId        String               @db.VarChar(36)
  sequenceNumber    BigInt
  status            DispatchIntentStatus
  deliveredAt       DateTime?
  archivedAt        DateTime
  createdAt         DateTime
  updatedAt         DateTime
  archiveBatchId    String               @db.VarChar(36)
  archivedReason    ArchivalReason
  archivedTimestamp DateTime             @default(now())

  @@index([archiveBatchId])
  @@index([outboxId])
  @@index([consumerId])
}

model DeliveryLedgerArchive {
  id                  String           @id @db.VarChar(36)
  intentId            String           @db.VarChar(36)
  consumerId          String           @db.VarChar(36)
  outboxId            String           @db.VarChar(36)
  claimEpoch          BigInt
  claimCount          Int
  leaseToken          String?          @db.VarChar(36)
  leaseExpiresAt      DateTime?
  lastWorkerId        String?
  outcome             DeliveryOutcome?
  outcomeReason       String? @db.Text
  executionDurationMs Int?
  createdAt           DateTime
  updatedAt           DateTime
  archiveBatchId      String           @db.VarChar(36)
  archivedReason      ArchivalReason
  archivedTimestamp   DateTime         @default(now())

  @@index([archiveBatchId])
  @@index([intentId])
  @@index([consumerId])
  @@index([outboxId])
}




