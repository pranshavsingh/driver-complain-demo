{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "M4_ALLOW_DESTRUCTIVE_TEST_DB",
    "M4_EXPECTED_TEST_SYSTEM_IDENTIFIER",
    "M4_TEST_DISPOSABLE_DB_URL",
    "GITHUB_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "M4_ALLOW_DESTRUCTIVE_TEST_DB",
        "M4_EXPECTED_TEST_SYSTEM_IDENTIFIER",
        "M4_TEST_DISPOSABLE_DB_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
